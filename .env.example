# 环境变量模板（提交到 Git）。
# 作用：列出项目需要的配置项与示例值，不含真实密钥。
# 使用：复制本文件为同目录下的 .env，再按本机/服务器填写真实值。
APP_ENV=development

# PostgreSQL（与 compose.yaml 中 postgres 服务一致；仅本机开发示例密码）
POSTGRES_USER=doctrain
POSTGRES_PASSWORD=doctrain_dev
POSTGRES_DB=doctrain
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# G2：后端 config.settings.database_url 读取本项（SQLAlchemy + psycopg 格式）
DATABASE_URL=postgresql+psycopg://doctrain:doctrain_dev@127.0.0.1:5432/doctrain
# pytest 专用测试库（tests/conftest.py 自动建库、重置 schema 并跑迁移，与开发库隔离）。
# 留空则默认由 DATABASE_URL 的库名追加 _test 派生（doctrain_test）
TEST_DATABASE_URL=

# C1/C seed：首次 seed 写入的超级管理员（本地示例，部署务必改掉）
INIT_ADMIN_USERNAME=admin
INIT_ADMIN_PASSWORD=change-me-dev

# D-A：Access Token（本地示例密钥，生产必须更换）
JWT_SECRET=dev-jwt-secret-change-in-production
JWT_EXPIRE_MINUTES=480

# D-C：前端开发地址（Vite 默认 5173）；多个 Origin 用英文逗号分隔
CORS_ORIGINS=http://localhost:5173

# F0：文档上传（相对路径相对于 server/）
FILE_STORAGE_DIR=storage
FILE_MAX_MB=20
ALLOWED_EXTENSIONS=pdf,md,docx,xlsx,pptx

# 存储后端：阶段 1 仅 local（S3 客户端未实现，勿改成 s3）
STORAGE_BACKEND=local
# 生产切对象存储时启用（阶段 1 不读取实现，仅预留）
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_BUCKET=doctrain
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=us-east-1

# D3：办公文档预览（需本机安装 LibreOffice；可空=自动探测 soffice）
# LIBREOFFICE_PATH=/Applications/LibreOffice.app/Contents/MacOS/soffice
LIBREOFFICE_TIMEOUT_SECONDS=60

# ---------- 阶段 2：解析队列 / Embedding / 切分 / 混合检索 ----------
# Redis 仅给 ARQ 用，不存业务文档
REDIS_URL=redis://127.0.0.1:6379/0
# Embedding（OpenAI 兼容协议；维度必须与模型一致）
EMBEDDING_BASE_URL=https://maas.qianwenaiapi.com/compatible-mode/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024
# 切分（字符窗口；正式 Worker 读取这些配置）
CHUNK_SIZE=500
CHUNK_OVERLAP=80
# 混合检索：向量分权重；全文权重 = 1 - HYBRID_VECTOR_WEIGHT
HYBRID_VECTOR_WEIGHT=0.7
# 解析失败重试次数（不含首跑）；耗尽后才标 failed
PARSE_MAX_RETRY=2

# ---------- 阶段 3：智能对话（与 Embedding 配置分开） ----------
# 对话模型（OpenAI 兼容协议）；与 EMBEDDING_BASE_URL 可同可不同，分开配置
CHAT_BASE_URL=https://maas.qianwenaiapi.com/compatible-mode/v1
CHAT_API_KEY=
CHAT_MODEL=qwen-plus
# 对话检索片段条数
RETRIEVAL_TOP_K=5
# 合并后最高分低于该阈值时拒答（0~1）
ABSTAIN_SCORE_THRESHOLD=0.35
ABSTAIN_MESSAGE=抱歉，我无法从现有资料中找到足够的相关信息来回答这个问题。
# 带入模型的历史消息条数（最近 N 条）
MEMORY_TURNS_MESSAGES=6