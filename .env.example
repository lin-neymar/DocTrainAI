# 环境变量模板（提交到 Git）。
# 作用：列出项目需要的配置项与示例值，不含真实密钥。
# 使用：复制本文件为同目录下的 .env，再按本机/服务器填写真实值。
APP_ENV=development

# PostgreSQL（与 compose.yaml 中 postgres 服务一致；仅本机开发示例密码）
POSTGRES_USER=doctrain
POSTGRES_PASSWORD=doctrain_dev
POSTGRES_DB=doctrain
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# G2：后端 config.settings.database_url 读取本项（SQLAlchemy + psycopg 格式）
DATABASE_URL=postgresql+psycopg://doctrain:doctrain_dev@127.0.0.1:5432/doctrain
